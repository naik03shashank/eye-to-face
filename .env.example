# --- required ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- models (check Google's current model list; the image model must support image output) ---
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash

# --- server ---
PORT=3000
# Number of reverse proxies in front of the app. Set to 1 on Render, Railway, Fly or nginx so rate limits see real client IPs
TRUST_PROXY=0
# Only needed if the frontend is hosted on a DIFFERENT origin (comma separated)
CORS_ORIGIN=

# --- abuse / cost protection ---
RATE_LIMIT_MAX=5            # artworks per IP per window
RATE_LIMIT_WINDOW_MIN=10
DAILY_LIMIT=300             # total generations per UTC day for the whole service
MAX_CONCURRENT=3            # simultaneous Gemini calls
MAX_IMAGE_MB=4
